{
  "info": {
    "name": "HRMS \u00b7 Org chart",
    "description": "Full tree, By department, By team, By project. Members are edited with PUT /projects/{id}/members.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 \u00b7 Full tree",
      "item": [
        {
          "name": "Full tree",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/org/tree",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "org",
                "tree"
              ],
              "query": [
                {
                  "key": "rootId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "depth",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "departmentId",
                  "value": "{{departmentId}}",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "include",
                  "value": "teams,projects,extraDepts",
                  "disabled": true
                }
              ],
              "variable": []
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json(); const first=(j.roots||[])[0]; if(first){pm.environment.set('headId', first.id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Search (hits + expand)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/org/tree",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "org",
                "tree"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "design",
                  "disabled": false
                }
              ],
              "variable": []
            }
          },
          "response": []
        },
        {
          "name": "One department (rooted at its head)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/org/tree",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "org",
                "tree"
              ],
              "query": [
                {
                  "key": "departmentId",
                  "value": "{{departmentId}}",
                  "disabled": false
                }
              ],
              "variable": []
            }
          },
          "response": []
        },
        {
          "name": "Lazy subtree",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/org/tree",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "org",
                "tree"
              ],
              "query": [
                {
                  "key": "rootId",
                  "value": "{{headId}}",
                  "disabled": false
                },
                {
                  "key": "depth",
                  "value": "3",
                  "disabled": false
                }
              ],
              "variable": []
            }
          },
          "response": []
        },
        {
          "name": "Reporting health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/org/reporting-health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "org",
                "reporting-health"
              ],
              "query": [],
              "variable": []
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2 \u00b7 By department",
      "item": [
        {
          "name": "By department",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/org/departments-view",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "org",
                "departments-view"
              ],
              "query": [
                {
                  "key": "headId",
                  "value": "{{headId}}",
                  "disabled": true
                }
              ],
              "variable": []
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json(); if(j.heads&&j.heads.length){pm.environment.set('headId', j.heads[0].id);}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 \u00b7 By team",
      "item": [
        {
          "name": "By team",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/org/teams-view",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "org",
                "teams-view"
              ],
              "query": [
                {
                  "key": "departmentId",
                  "value": "{{departmentId}}",
                  "disabled": true
                }
              ],
              "variable": []
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "4 \u00b7 By project",
      "item": [
        {
          "name": "By project",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/org/projects-view",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "org",
                "projects-view"
              ],
              "query": [
                {
                  "key": "includeCompleted",
                  "value": "false",
                  "disabled": true
                }
              ],
              "variable": []
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json(); if(j.projects&&j.projects.length){pm.environment.set('projectId', j.projects[0].id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Add-person options",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/org/projects-view/:id/candidates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "org",
                "projects-view",
                ":id",
                "candidates"
              ],
              "query": [],
              "variable": [
                {
                  "key": "id",
                  "value": "{{projectId}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json(); if(Array.isArray(j)&&j.length){pm.environment.set('employeeId', j[0].id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Add person (default allocation)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "If-Match",
                "value": "{{projectVersion}}",
                "disabled": true
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/:id/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                ":id",
                "members"
              ],
              "query": [],
              "variable": [
                {
                  "key": "id",
                  "value": "{{projectId}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"upsert\": [\n    {\n      \"employeeId\": \"{{employeeId}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Change role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/:id/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                ":id",
                "members"
              ],
              "query": [],
              "variable": [
                {
                  "key": "id",
                  "value": "{{projectId}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"upsert\": [\n    {\n      \"employeeId\": \"{{employeeId}}\",\n      \"role\": \"REVIEWER\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Change allocation",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/:id/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                ":id",
                "members"
              ],
              "query": [],
              "variable": [
                {
                  "key": "id",
                  "value": "{{projectId}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"upsert\": [\n    {\n      \"employeeId\": \"{{employeeId}}\",\n      \"allocation\": 40\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Remove person",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/:id/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                ":id",
                "members"
              ],
              "query": [],
              "variable": [
                {
                  "key": "id",
                  "value": "{{projectId}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remove\": [\n    \"{{employeeId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const t = pm.environment.get('token');",
          "if (t) { pm.request.headers.upsert({key:'Authorization', value:'Bearer ' + t}); }",
          "else if (pm.environment.get('devUser')) { pm.request.headers.upsert({key:'X-Dev-User', value: pm.environment.get('devUser')}); }"
        ]
      }
    }
  ]
}