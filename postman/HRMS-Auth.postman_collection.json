{
  "info": {
    "name": "HRMS \u00b7 Sign-in",
    "description": "Sign-in, two-step, reset, set-up and sessions. Sign in first: the token is stored in {{accessToken}} and used by the other folders. The refresh cookie hrms_rt is kept by Postman automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 \u00b7 Sign in",
      "item": [
        {
          "name": "Sign-in options",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "config"
              ],
              "query": [],
              "variable": []
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Sign in (email + password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"remember\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json(); if(j.accessToken){pm.environment.set('accessToken', j.accessToken);}",
                  "if(j.challengeId){pm.environment.set('challengeId', j.challengeId);}",
                  "if(j.enrollToken){pm.environment.set('enrollToken', j.enrollToken);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Two-step code",
