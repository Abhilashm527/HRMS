                  "key": "window",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "",
                  "disabled": true
                }
              ],
              "variable": []
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "if(j.items&&j.items.length){const h=j.items[0];",
                  "pm.environment.set('hireId',h.id);",
                  "pm.environment.set('departmentId',h.department.id);",
                  "pm.environment.set('locationId',h.location.id);",
                  "pm.environment.set('employmentTypeId',h.employmentType.id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /onboarding/hires",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/onboarding/hires",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "onboarding",
                "hires"
              ],
              "query": [
                {
                  "key": "invite",
                  "value": "",
                  "disabled": true
                }
              ],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": {\n    \"first\": \"Asha\",\n    \"last\": \"Nair\",\n    \"pemail\": \"asha.nair@example.com\",\n    \"phone\": \"+91 99999 11111\",\n    \"gender\": \"Female\",\n    \"dob\": \"1996-03-14\",\n    \"title\": \"Software Engineer\",\n    \"dept\": \"{{departmentId}}\",\n    \"mgr\": \"{{managerId}}\",\n    \"loc\": \"{{locationId}}\",\n    \"etype\": \"{{employmentTypeId}}\",\n    \"doj\": \"2026-11-10\",\n    \"prob\": \"6\",\n    \"ctc\": 18\n  },\n  \"extra\": {},\n  \"m365\": {\n    \"upnUser\": \"asha.nair\",\n    \"license\": \"Microsoft 365 Business Standard\",\n    \"groups\": [\n      \"All staff\",\n      \"{department}\"\n    ],\n    \"forceReset\": true,\n    \"sendSms\": true,\n    \"provisionNow\": false\n  },\n  \"documents\": [\n    {\n      \"key\": \"pan\",\n      \"required\": true\n    },\n    {\n      \"key\": \"aadhaar\",\n      \"required\": true\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json(); if(j.id){pm.environment.set('hireId',j.id); pm.environment.set('hireVersion',j.version);}"
                ]
              }
            }
          ]
        },
